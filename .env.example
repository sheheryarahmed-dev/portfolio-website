# Public canonical site URL. Leave empty for local development.
NEXT_PUBLIC_SITE_URL=

# Server-only contact credentials. FROM must be a verified sender email address.
RESEND_API_KEY=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=
TURNSTILE_SECRET_KEY=

# Public Cloudflare Turnstile site key. Restrict its allowed hostnames in Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
